{
  "id": "./",
  "name": "Bharat Stampbook",
  "short_name": "Stampbook",
  "description": "Explore India state by state and collect verified digital stamps at landmark destinations.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "./?country=india&state=telangana",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#fffaf0",
  "theme_color": "#0a2a5e",
  "categories": ["travel", "lifestyle"],
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
